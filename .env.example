# Skopiuj ten plik jako .env i uzupełnij danymi swojego projektu Firebase:
# Konsola Firebase → Ustawienia projektu (⚙️) → Twoje aplikacje → aplikacja Web → firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Opcjonalnie: lokalne emulatory Firebase zamiast prawdziwego projektu (patrz README).
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost
